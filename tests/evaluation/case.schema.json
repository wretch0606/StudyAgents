{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://studyagents.local/schemas/evaluation-case.schema.json",
  "title": "StudyAgentsEvaluationCase",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "category",
    "mode",
    "query",
    "student_answer",
    "source_scope",
    "expected_behavior",
    "expected_evidence",
    "evidence_match",
    "scoring_policy",
    "critical",
    "tags"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^db-[0-9]{3}$"
    },
    "category": {
      "enum": [
        "fact_qa",
        "computation_short_answer",
        "visual",
        "refusal",
        "cross_knowledge"
      ]
    },
    "mode": {
      "enum": ["qa", "training"]
    },
    "query": {
      "type": "string",
      "minLength": 4,
      "maxLength": 300
    },
    "student_answer": {
      "type": ["string", "null"],
      "maxLength": 500
    },
    "source_scope": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "expected_behavior": {
      "enum": ["answer", "refuse", "clarify", "flag_conflict", "grade"]
    },
    "expected_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["document_id", "pages"],
        "properties": {
          "document_id": {"type": "string"},
          "pages": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "integer", "minimum": 1},
            "uniqueItems": true
          }
        }
      }
    },
    "evidence_match": {
      "enum": ["any", "all", "none"]
    },
    "scoring_policy": {
      "type": "string"
    },
    "critical": {
      "type": "boolean"
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"},
      "uniqueItems": true
    }
  }
}
