# StudyAgents — 统一换行符策略
# 所有文本文件统一使用 LF，避免 Windows CI 检出 CRLF 导致 bash/docker 解析错误

# Shell 脚本 (必须 LF，否则 bash 语法错误)
*.sh       text eol=lf

# Python 源码
*.py       text eol=lf

# 配置文件
*.yml      text eol=lf
*.yaml     text eol=lf
*.toml     text eol=lf
*.ini      text eol=lf
*.env      text eol=lf
Dockerfile text eol=lf

# Web 前端
*.ts       text eol=lf
*.tsx      text eol=lf
*.js       text eol=lf
*.jsx      text eol=lf
*.vue      text eol=lf
*.json     text eol=lf
*.css      text eol=lf
*.html     text eol=lf
*.md       text eol=lf

# 二进制文件
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.pdf      binary
*.lock     binary
